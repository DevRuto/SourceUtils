# Copy to .env (untracked - see .gitignore) and fill in what you need. All of these are optional;
# unset vars fall back to the defaults documented in docker-compose.yml.

# Point at an existing Source game install's csgo-style folder instead of downloading one via the
# `gamedir` service.
#GAME_DIR=/path/to/csgo

# Watch/export your own maps instead of the ones bundled with the game install.
#MAPS_DIR=/path/to/my/maps

# Map name(s)/glob for a one-off `docker compose --profile export run --rm mapexport`.
#MAPS=kz_reach_v2

# How often mapexport-watch polls for new .bsp files, in seconds.
#POLL_SECONDS=30
